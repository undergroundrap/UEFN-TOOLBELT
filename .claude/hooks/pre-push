#!/bin/sh
#
# Block pushing UEFN runtime code that has not been declared live-verified.
#
# Context: Toolbelt runs inside UEFN. pytest, ruff and mypy all pass on code that
# is completely wrong in the editor — the material tools were green while every
# one of them silently applied the engine fallback. CLAUDE.md therefore requires
# live confirmation before shipping, and on 2026-08-21 that rule was followed for
# four commits and then quietly skipped for a fifth.
#
# This hook cannot verify anything in UEFN. What it can do is refuse to let a
# runtime change leave the machine without someone SAYING what was run. It turns
# an omission into a deliberate act.
#
# Add one of these trailers to the commit message:
#
#   Verified-Live: tag_list_all in TOOL_TEST, $Digest errors gone
#   Live-Verification: not-required — docs only
#
# Escape hatch: git push --no-verify   (defeats the purpose; prefer a trailer)

RUNTIME_PATHS='^Content/Python/'
z40='0000000000000000000000000000000000000000'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue            # branch deletion

    if [ "$remote_sha" = "$z40" ]; then
        range=$(git rev-list --max-count=50 "$local_sha" --not --remotes | tail -r 2>/dev/null \
                || git rev-list --max-count=50 "$local_sha" --not --remotes)
    else
        range=$(git rev-list "$remote_sha..$local_sha")
    fi

    for sha in $range; do
        git diff-tree --no-commit-id --name-only -r "$sha" | grep -q "$RUNTIME_PATHS" || continue
        msg=$(git log -1 --format=%B "$sha")
        case "$msg" in
            *Verified-Live:*|*Live-Verification:*) ;;
            *)
                if [ "$fail" -eq 0 ]; then
                    echo ""
                    echo "  BLOCKED — runtime changes without a live-verification trailer:"
                    echo ""
                fi
                echo "    $(git log -1 --format='%h %s' "$sha")"
                fail=1
                ;;
        esac
    done
done

if [ "$fail" -ne 0 ]; then
    cat <<'MSGEOF'

  These touch Content/Python/, which runs inside UEFN. Local tests passing is
  not evidence it works there — that is exactly how the material tools shipped
  green while applying the wrong material.

  Run it in the editor, then amend or add a commit trailer:

    Verified-Live: <what you ran and what you saw>

  Or state that it does not need one:

    Live-Verification: not-required — <reason>

MSGEOF
    exit 1
fi
exit 0
